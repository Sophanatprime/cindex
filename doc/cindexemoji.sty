\cs_new_protected:Npn \__cnemj_check_char:NnN #1 #2 #3
  {
    \int_set:Nn \l__cnemj_prev_int { `#1 }
    \tl_put_right:Nn \l__cnemj_collect_tl {#1}
    \tl_set:Ne \l__cnemj_tmp_tl { g__cnemj_char_ #2 - \int_value:w `#3 _prop }
    \prop_if_exist:cTF { \l__cnemj_tmp_tl }
