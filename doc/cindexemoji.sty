\cs_new_protected:Npn \__cnemj_declare:nn #1#2
  {
    \int_set:Nn \l__cnemj_page_int {#2}
    \int_compare:nNnTF { \exp_after:wN ` \tl_head:w #1 \q_stop } < { 128 }
      {
        \msg_info:nnee { cindexemoji } { ignore }
          { \exp_not:n {#1} } { \int_use:N \l__cnemj_page_int }
      }
      { \__cnemj_declare_auxi:N #1 \q_mark \q_mark \q_stop }
  }
\cs_new_protected:Npn \__cnemj_declare_auxi:N #1 #2
  {
    \int_set:Nn \l__cnemj_prev_int { `#1 }
    \tl_set:Nn \l__cnemj_collect_tl {#1}
    \int_set:Nn \l__cnemj_level_int { 1 }
    \token_if_eq_meaning:NNTF #2 \q_mark
      {
        \__cnemj_declare_single:N #1
        \use_none_delimit_by_q_stop:w
      }
      {
        \prop_if_exist:cF { g__cnemj_char_ 0 - \int_use:N \l__cnemj_prev_int _prop }
          { \prop_new:c { g__cnemj_char_ 0 - \int_use:N \l__cnemj_prev_int _prop } }
        \__cnemj_declare_root:N #1
        \prop_gput:cne { g__cnemj_char_ 0 - \int_use:N \l__cnemj_prev_int _prop } {#2}
          { \__cnemj_check_char:NnN \exp_not:N #1 { \int_use:N \l__cnemj_level_int } \exp_not:N #2 }
        \__cnemj_declare_auxii:NN #2
      }
  }
\cs_new_protected:Npn \__cnemj_declare_auxii:NN #1 #2
  {
    \tl_put_right:Nn \l__cnemj_collect_tl {#1}
    \int_set:Nn \l__cnemj_prev_int { `#1 }
    \token_if_eq_meaning:NNTF #2 \q_mark
