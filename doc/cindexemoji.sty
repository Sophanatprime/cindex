        \tl_set:Ne \l__cnemj_tmp_tl
          { g__cnemj_char_ \int_use:N \l__cnemj_level_int - \int_use:N \l__cnemj_prev_int _prop }
        \int_incr:N \l__cnemj_level_int
        \prop_if_exist:cF { \l__cnemj_tmp_tl } { \prop_new:c { \l__cnemj_tmp_tl } }
        \prop_gput:cne { \l__cnemj_tmp_tl } {#2}
          { \__cnemj_check_char:NnN \exp_not:N #1 { \int_use:N \l__cnemj_level_int } \exp_not:N #2 }
        \__cnemj_declare_auxii:NN #2
      }
  }


