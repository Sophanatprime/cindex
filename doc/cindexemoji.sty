          { \__cnemj_check_use:oN \l__cnemj_collect_tl #3 }
      }
      { \__cnemj_check_use:oN \l__cnemj_collect_tl #3 }
  }
\cs_new_protected_nopar:Npn \__cnemj_check_char_next:NN #1 #2
