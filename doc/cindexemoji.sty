\cs_new_protected:Npn \__cnemj_check_char:NN #1#2
  {
    \tl_set:Ne \l__cnemj_tmp_tl
      { g__cnemj_char_ 0 - \int_use:N \l__cnemj_prev_int _prop }
    \prop_get:cnNTF { \l__cnemj_tmp_tl } {#2} \l__cnemj_tmpc_tl
      { \tl_clear:N \l__cnemj_collect_tl \l__cnemj_tmpc_tl }
      { \__cnemj_check_use:oN \l__cnemj_collect_tl #2 }
