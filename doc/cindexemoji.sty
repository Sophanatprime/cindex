\prg_new_conditional:Npnn \__cnemj_if_in_csname: { TF }
  { \tex_ifincsname:D \prg_return_true: \else: \prg_return_false: \fi: }
\cs_new_protected:Npn \__cnemj_declare_root:N #1
  {
    \cs_set_protected_nopar:Npn \__cnemj_declare_auxc:w
      {
        \__cnemj_if_in_csname:TF { \token_to_str:N #1 }
          {
            \int_set:Nn \l__cnemj_prev_int { `#1 }
            \tl_set:Nn \l__cnemj_collect_tl {#1}
            \prop_if_exist:cTF
              { g__cnemj_char_ 0 - \int_use:N \l__cnemj_prev_int _prop }
              {
                \peek_N_type:TF
                  { \__cnemj_check_char:NN #1 }
                  { \__cnemj_check_use:o \l__cnemj_collect_tl }
              }
              { \__cnemj_check_use:n {#1} }
          }
      }
    \char_set_catcode_active:n { `#1 }
    \char_set_active_eq:nN { `#1 } \__cnemj_declare_auxc:w
  }
\cs_new_protected:Npn \__cnemj_check_use:n #1
  {
    \cs_if_exist_use:cF { __cnemj_emoji_ \tl_to_str:n {#1} : }
      {
        % \msg_warning:nnn { cindexemoji } { unknown } {#1}
        \tl_to_str:n {#1}
      }
  }
\cs_new_protected_nopar:Npn \__cnemj_check_use:oN #1#2
  {
    \cs_if_exist_use:cF { __cnemj_emoji_ \tl_to_str:o {#1} \token_to_str:N #2 : }
      {
        \cs_if_exist_use:cF { __cnemj_emoji_ \tl_to_str:o {#1} : }
          { \tl_to_str:o {#1} }
        #2
      }
  }
