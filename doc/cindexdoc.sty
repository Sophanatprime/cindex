  {
local function print_tone(pre, t, n)
    local normal_funcs = function (t_, n_)
        local tab = { [1] = "\\\\=", [2] = "\\\\'", [3] = "\\\\v", [4] = "\\\\`"};
        return (tab[n_] or "") .. "{" .. t_ .. "}";
    end;
    local funcs = {
        ['i'] = function (t_, n_)
            local tab = { [1] = 'ī', [2] = 'í', [3] = 'ǐ', [4] = 'ì' };
            return tab[n_] or 'i';
        end,
        ['v'] = function (t_, n_)
            local rep = { ['l'] = true, ['n'] = true, ['L'] = true, ['N'] = true };
            local tab = { [1] = 'ǖ', [2] = 'ǘ', [3] = 'ǚ', [4] = 'ǜ' };
            if rep[pre] then
                return tab[n_] or 'ü';
            else
                return normal_funcs('u', n_);
            end
        end,
        ['ü'] = function (t_, n_)
            local rep = { ['l'] = true, ['n'] = true, ['L'] = true, ['N'] = true };
            local tab = { [1] = 'ǖ', [2] = 'ǘ', [3] = 'ǚ', [4] = 'ǜ' };
            if rep[pre] then
                return tab[n_] or 'ü';
            else
                return normal_funcs('u', n_);
            end
        end,
    };
    return (funcs[t] or normal_funcs)(t, tonumber(n));
end
local function replace_v(c)
    local rep = { ['l'] = true, ['n'] = true, ['L'] = true, ['N'] = true };
    if c == 'v' or c == 'ü' then
        if rep[c] then return 'ü' else return 'u' end
    else
        return c;
    end
end
local function pinyin(s)
    local tone_table = { ['a'] = 3, ['e'] = 2, ['i'] = 2, ['o'] = 1, ['u'] = 1, ['v'] = 1, ['ü'] = 1 };
    local first = true;
    local item = "";
    local pre = "";
    local tone = "";
    local post = "";
    for i = 1, #s do
        local curr = s:sub(i, i);
        local n = tonumber(curr);
        if n then
            if first then first = false end
            return tostring(pre) .. print_tone(pre, tone, n) .. tostring(post);
        else
            if (tone_table[tone] or 0) > (tone_table[curr] or 0) then
                post = post .. curr;
            else
                tone = curr;
                pre = tostring(item);
                post = "";
            end
            item = item .. replace_v(curr);
        end
    end
    if first then
        return tostring(s);
    else
        return tostring(item);
    end
end
cindex = cindex or {};
cindex.pinyin = pinyin;
